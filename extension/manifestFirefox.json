{
  "manifest_version": 3,
  "name": "Extension Name",
  "description": "Extension description",
  "version": "1.0.0",
  "permissions": ["storage", "alarms"],
  "action": { "default_popup": "popup.html", "default_title": "Extension Settings" },
  "host_permissions": ["https://*.twitch.tv/*", "YOUR_API_ENDPOINT"],
  "content_scripts": [
    {
      "matches": ["https://*.twitch.tv/*"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "icons": {},
  "browser_specific_settings": {
    "gecko": {
      "id": "extension-id@1",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
