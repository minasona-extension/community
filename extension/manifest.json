{
  "manifest_version": 3,
  "name": "Extension name",
  "description": "Extension description",
  "version": "1.0.0",
  "permissions": ["storage", "alarms"],
  "action": { "default_popup": "popup.html", "default_title": "Extension Settings" },
  "host_permissions": ["https://*.twitch.tv/*", "YOUR_API_ENDPOINT"],
  "content_scripts": [
    {
      "matches": ["https://*.twitch.tv/*"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {}
}
